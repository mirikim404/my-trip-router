# === 필수 ===

# 네이버클라우드플랫폼(NCP) > AI·Application Service > API GATEWAY > API HUB 에서
# "지역 검색(Local Search)" 상품을 신청하면 발급됩니다. (/api/search 에서 사용)
API_HUB_CLIENT_ID=
API_HUB_CLIENT_SECRET=

# Google Cloud Console 에서 발급. 아래 두 API를 반드시 함께 활성화하세요.
#   - Routes API   (대중교통 길찾기: /api/transit)
#   - Places API   (장소 상세정보/사진: /api/place-details, /api/place-photo)
GOOGLE_MAPS_API_KEY=


# === 권장 ===

# NCP Maps 애플리케이션(AI·NAVER API > Application)에서 발급한 키.
# 애플리케이션 변경 화면에서 "Directions 5"가 선택되어 있어야 해요. (아니면 429 Quota Exceeded)
# 가까운 구간(도보권 ~1.2km)의 도로 기준 경로(/api/transit)에 쓰여요.
# 비워두면 네이버 경로는 건너뛰고 Google 대중교통 → 직선 순서로만 시도해요.
NCP_MAP_CLIENT_ID=
NCP_MAP_CLIENT_SECRET=


# === 선택 ===

# 네이버 자동차 길찾기 주소. 기본값은 Directions 5 예요.
# Directions 15를 구독 중이라면 아래 주소로 바꾸세요.
# NAVER_DIRECTIONS_URL=https://naveropenapi.apigw.ntruss.com/map-direction-15/v1/driving

# 백엔드 서버 포트 (기본값 3001). 배포 플랫폼이 자체 PORT를 주입하는 경우
# 그 값이 우선 적용되므로 보통 로컬 개발용으로만 지정하면 됩니다.
PORT=3001
